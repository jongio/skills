# Dependencies are vendored — there is no install step and no node_modules.
node_modules/
dist/
build/

# Optional dev tooling (the Vally eval) pulls dev deps + writes results.
# Shipped canvases stay dependency-free; these are skill-repo dev artifacts only.
package-lock.json
!skills/*/package-lock.json
!skills/create-skills-repo/templates/repository/.github/tools/vally/package-lock.json
!skills/create-skills-repo/templates/repository/skills/create-skill/package-lock.json
vally-results/

# Local canvas state written by the reference extension / generated canvases.
artifacts/

# Local browser automation session artifacts.
.playwright-cli/
.playwright-mcp/

# Local agent tooling state and review receipts. These were previously covered
# only by .git/info/exclude, which is per-clone and never shared, so a fresh
# clone would have committed them.
.impeccable/
.code-review/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
