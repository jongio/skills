---
import Layout from "../../layouts/Layout.astro";
import SkillGrid from "../../components/SkillGrid.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const skills = (await getCollection("skills")).sort((a, b) =>
  a.id.localeCompare(b.id),
);
---

<Layout wide title="Skills · jongio/skills" description="The skills in jongio/skills — install any one, or the whole repo.">
  <header style="text-align:center;margin-bottom:1.75rem;">
    <h1 style="font-size:clamp(1.75rem,5vw,2.5rem);margin:0 0 .5rem;">Skills</h1>
    <p class="muted">Find a skill for your task. Each guide explains what you get, how to install it, and what to ask your agent.</p>
    <p class="muted" style="max-width:78ch;margin:0.75rem auto 0;font-size:0.94rem;">
      <strong>How the delivery workflow skills fit together:</strong> triage issues with
      <a href={`${base}catalog/backlog-groom/`}><code>backlog-groom</code></a>, plan and implement with
      <a href={`${base}catalog/go/`}><code>go</code></a> (or scope structural changes with
      <a href={`${base}catalog/refactor/`}><code>refactor</code></a>), audit tests and docs with
      <a href={`${base}catalog/test-doctor/`}><code>test-doctor</code></a> and
      <a href={`${base}catalog/doc-doctor/`}><code>doc-doctor</code></a>, ship and merge with
      <a href={`${base}catalog/pr/`}><code>pr</code></a>, monitor main CI with
      <a href={`${base}catalog/ci-doctor/`}><code>ci-doctor</code></a>, and close out or refine skills with
      <a href={`${base}catalog/retro/`}><code>retro</code></a>,
      <a href={`${base}catalog/skill-doctor/`}><code>skill-doctor</code></a>, and
      <a href={`${base}catalog/git-tidy/`}><code>git-tidy</code></a>. Track live progress in the terminal footer with
      <a href={`${base}catalog/session-statusline/`}><code>session-statusline</code></a> or in a side-panel board with
      <a href={`${base}catalog/create-session-board-canvas/`}><code>create-session-board-canvas</code></a>.
    </p>
  </header>
  <SkillGrid skills={skills} />
</Layout>
