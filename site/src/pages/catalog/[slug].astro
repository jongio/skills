---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { thumbnailFor } from "../../thumbnails";

export async function getStaticPaths() {
  const skills = await getCollection("skills");
  return skills.map((skill) => ({ params: { slug: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);
const base = import.meta.env.BASE_URL;
const repoUrl = `https://github.com/jongio/skills/tree/main/${skill.data.repoPath}`;
---

<Layout title={`${skill.data.title} · jongio/skills`} description={skill.data.tagline}>
  <p style="margin:0 0 1rem;"><a href={`${base}catalog/`}>← All skills</a></p>

  <header class="skill-head">
    <Image
      class="skill-hero"
      src={thumbnailFor(skill.data.thumb)}
      alt={`${skill.data.title} illustration`}
      widths={[512, 768, 1024]}
      sizes="(max-width: 760px) calc(100vw - 72px), 688px"
      width={1024}
      height={1024}
      format="webp"
      quality={80}
    />
    <h1>{skill.data.title}</h1>
    <p class="muted lede">{skill.data.tagline}</p>
    <p class="usewhen"><strong>Use when:</strong> {skill.data.useWhen}</p>
    <p class="actions">
      <a class="btn" href={repoUrl}>Source &amp; README</a>
      {skill.data.gallery && (
        <a class="btn" href={skill.data.gallery}>Template gallery</a>
      )}
    </p>
  </header>

  <section class="card install-section">
    <h2>Install</h2>
    <p class="muted" style="margin:0 0 1rem;">
      Install the namespaced plugin globally across your coding agents (keeps <code>/jongio-skills:{skill.id}</code> conflict-free and includes sibling skills), or install just <code>{skill.id}</code> into a project.
    </p>

    <div class="install-split">
      <div class="install-box install-box--primary">
        <div class="install-box__head">
          <span class="install-badge">Recommended · Global plugin</span>
          <strong>Install all skills &amp; statuslines (namespaced)</strong>
        </div>

        <p class="install-label">One-liner across detected CLIs (Copilot, Claude, Codex &amp; Gemini):</p>
        <pre><code>irm https://raw.githubusercontent.com/jongio/skills/main/install.ps1 | iex</code></pre>
        <pre><code>curl -fsSL https://raw.githubusercontent.com/jongio/skills/main/install.sh | bash</code></pre>

        <p class="install-label">Or inside Copilot CLI / Claude Code:</p>
        <pre><code>/plugin marketplace add jongio/skills</code></pre>
        <pre><code>/plugin install jongio-skills@jongio-skills</code></pre>

        <p class="install-label">In Codex CLI or Gemini CLI:</p>
        <pre><code>codex plugin marketplace add jongio/skills &amp;&amp; codex plugin add jongio-skills</code></pre>
        <pre><code>gemini extensions install https://github.com/jongio/skills --consent</code></pre>
      </div>

      <div class="install-box">
        <div class="install-box__head">
          <span class="install-badge install-badge--neutral">This skill only</span>
          <strong>Install just <code>{skill.id}</code></strong>
        </div>

        <p class="install-label">Project scope via Skills CLI (avoids global <code>~/.agents/skills</code> plugin shadowing):</p>
        <pre><code>{`npx skills add jongio/skills --skill ${skill.id}`}</code></pre>

        {skill.id !== "pr" ? (
          <>
            <p class="install-label">Or single-skill plugin in Copilot CLI:</p>
            <pre><code>/plugin marketplace add jongio/skills</code></pre>
            <pre><code>{`/plugin install ${skill.id}@jongio-skills`}</code></pre>
          </>
        ) : (
          <p class="muted" style="margin:0.65rem 0 0;">
            In Copilot CLI, install <code>jongio-skills@jongio-skills</code> above rather than a standalone <code>pr</code> plugin so the command is namespaced as <code>/jongio-skills:pr</code> instead of colliding with built-in <code>/pr</code>.
          </p>
        )}
      </div>
    </div>

    <p class="muted" style="margin:0.9rem 0 0;">In Copilot CLI, use <code>/skills reload</code> for newly installed skills. Start a new session if you installed the collection's statusline extensions.</p>
  </section>

  <article class="prose">
    <Content />
  </article>
</Layout>

<style>
  .skill-head { margin-bottom: 1.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .skill-hero {
    width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--panel); margin-bottom: 1.1rem; display: block;
    padding: 1rem;
  }
  .skill-head h1 {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(1.6rem, 5vw, 2.3rem); margin: 0 0 0.5rem;
  }
  .lede { font-size: 1.05rem; }
  .usewhen {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 9px; padding: 0.7rem 0.9rem; font-size: 0.95rem;
  }
  .card pre, .prose pre {
    background: var(--bg); border: 1px solid var(--border); border-radius: 9px;
    padding: 0.7rem 0.9rem; overflow-x: auto; margin: 0.35rem 0;
  }
  .install-split {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .install-box {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.15rem;
  }
  .install-box--primary {
    border: 2px solid color-mix(in srgb, var(--accent) 55%, var(--border));
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 8%, var(--bg)), var(--bg));
  }
  .install-box pre {
    background: var(--panel);
  }
  .install-box__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.65rem;
  }
  .install-badge {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--accent-solid);
    color: #fff;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
  }
  .install-badge--neutral {
    background: var(--panel);
    color: var(--muted);
    border: 1px solid var(--border);
  }
  .install-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0.75rem 0 0.25rem;
  }
  .prose :global(h2) { font-size: 1.25rem; margin: 1.8rem 0 0.6rem; }
  .prose :global(h3) { font-size: 1.05rem; margin: 1.3rem 0 0.5rem; }
  .prose :global(li) { margin: 0.25rem 0; }
</style>
