---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const skills = await getCollection("skills");
  return skills.map((skill) => ({ params: { slug: skill.id }, props: { skill } }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);
const base = import.meta.env.BASE_URL;
const repoUrl = `https://github.com/jongio/skills/tree/main/${skill.data.repoPath}`;
---

<Layout title={`${skill.data.title} · jongio/skills`} description={skill.data.tagline}>
  <p style="margin:0 0 1rem;"><a href={`${base}catalog/`}>← All skills</a></p>

  <header class="skill-head">
    <img class="skill-hero" src={`${base}${skill.data.thumb}`} alt={`${skill.data.title} illustration`} />
    <h1>{skill.data.title}</h1>
    <p class="muted lede">{skill.data.tagline}</p>
    <p class="usewhen"><strong>Use when:</strong> {skill.data.useWhen}</p>
    <p class="actions">
      <a class="btn" href={repoUrl}>Source &amp; README</a>
      {skill.data.gallery && (
        <a class="btn" href={skill.data.gallery}>Template gallery</a>
      )}
    </p>
  </header>

  <section class="card install-section">
    <h2>Install</h2>
    <p class="muted" style="margin:0 0 1rem;">
      Choose this skill or the full collection. Add the Copilot marketplace once; it does not need to be added again for each skill.
    </p>

    <div class="install-split">
      <div class="install-box install-box--primary">
        <div class="install-box__head">
          <span class="install-badge">This skill only</span>
          <strong>Install just <code>{skill.id}</code></strong>
        </div>

        <p class="install-label">In Copilot CLI (add marketplace once, then install this skill):</p>
        <pre><code>/plugin marketplace add jongio/skills</code></pre>
        <pre><code>{`/plugin install ${skill.id}@jongio-skills`}</code></pre>

        <p class="install-label">Or via Skills CLI (terminal):</p>
        <pre><code>{`npx skills add jongio/skills --skill ${skill.id} -g --agent github-copilot`}</code></pre>

      </div>

      <div class="install-box">
        <div class="install-box__head">
          <span class="install-badge install-badge--neutral">Full collection</span>
          <strong>Install all skills &amp; statuslines</strong>
        </div>

        <p class="install-label">In Copilot CLI (add marketplace once, then install the full bundle):</p>
        <pre><code>/plugin marketplace add jongio/skills</code></pre>
        <pre><code>/plugin install jongio-skills@jongio-skills</code></pre>

        <p class="install-label">Or via Skills CLI (all skills):</p>
        <pre><code>npx skills add jongio/skills --all</code></pre>
      </div>
    </div>

    <p class="muted" style="margin:0.9rem 0 0;">In Copilot CLI, use <code>/skills reload</code> for newly installed skills. Start a new session if you installed the collection's statusline extensions.</p>
  </section>

  <article class="prose">
    <Content />
  </article>
</Layout>

<style>
  .skill-head { margin-bottom: 1.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .skill-hero {
    width: 100%; aspect-ratio: 16 / 9; object-fit: contain;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--panel); margin-bottom: 1.1rem; display: block;
    padding: 1rem;
  }
  .skill-head h1 {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(1.6rem, 5vw, 2.3rem); margin: 0 0 0.5rem;
  }
  .lede { font-size: 1.05rem; }
  .usewhen {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 9px; padding: 0.7rem 0.9rem; font-size: 0.95rem;
  }
  .card pre, .prose pre {
    background: var(--bg); border: 1px solid var(--border); border-radius: 9px;
    padding: 0.7rem 0.9rem; overflow-x: auto; margin: 0.35rem 0;
  }
  .install-split {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .install-box {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.15rem;
  }
  .install-box--primary {
    border: 2px solid color-mix(in srgb, var(--accent) 55%, var(--border));
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 8%, var(--bg)), var(--bg));
  }
  .install-box pre {
    background: var(--panel);
  }
  .install-box__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.65rem;
  }
  .install-badge {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--accent-solid);
    color: #fff;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
  }
  .install-badge--neutral {
    background: var(--panel);
    color: var(--muted);
    border: 1px solid var(--border);
  }
  .install-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0.75rem 0 0.25rem;
  }
  .prose :global(h2) { font-size: 1.25rem; margin: 1.8rem 0 0.6rem; }
  .prose :global(h3) { font-size: 1.05rem; margin: 1.3rem 0 0.5rem; }
  .prose :global(li) { margin: 0.25rem 0; }
</style>
