  }
  .sl-install-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sl-install-item pre { margin: 0; }
  .sl-os-label {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
