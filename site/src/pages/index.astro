    color: var(--muted);
  }
  .sl-legend-crop {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0d1117;
    cursor: zoom-in;
    transition: border-color 0.15s ease;
  }
  .sl-legend-crop:hover, .sl-legend-crop:focus-visible {
    border-color: var(--accent);
    outline: none;
  }
  .sl-legend-crop img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sl-legend-item code {
    align-self: flex-start;
    font-weight: 700;
    color: var(--fg);
  }
  .img-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(1, 4, 9, 0.92);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
  }
  .img-zoom-overlay[hidden] { display: none; }
  .img-zoom-toolbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: rgba(13, 17, 23, 0.9);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .img-zoom-btn {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: #e6edf3;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    text-decoration: none;
  }
  .img-zoom-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .img-zoom-stage {
    flex: 1;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  #img-zoom-target {
    display: block;
    max-width: 96vw;
    max-height: calc(94vh - 56px);
    width: auto;
    height: auto;
    border-radius: 8px;
    border: 1px solid #30363d;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.85);
    cursor: zoom-in;
  }
  #img-zoom-target.is-actual-size {
    max-width: none;
    max-height: none;
    width: auto;
    cursor: zoom-out;
    margin: auto;
  }
</style>

<script>
  function wireStatuslineZoom() {
    const zoomOverlay = document.getElementById("img-zoom-overlay");
    const zoomTarget = document.getElementById("img-zoom-target") as HTMLImageElement | null;
    const zoomToggle = document.getElementById("img-zoom-toggle");
    const zoomRaw = document.getElementById("img-zoom-raw") as HTMLAnchorElement | null;
    const zoomClose = document.getElementById("img-zoom-close") as HTMLElement | null;
    if (!zoomOverlay || !zoomTarget || zoomOverlay.dataset.wired) return;
    zoomOverlay.dataset.wired = "1";

    let zoomLastFocus: HTMLElement | null = null;

    function openFullImage(src: string, alt = "Full-size image") {
      if (!zoomOverlay || !zoomTarget) return;
      zoomLastFocus = document.activeElement as HTMLElement;
      zoomTarget.src = src;
      zoomTarget.alt = alt;
      zoomTarget.classList.remove("is-actual-size");
      if (zoomToggle) zoomToggle.textContent = "1:1 Actual Size";
      if (zoomRaw) zoomRaw.href = src;
      zoomOverlay.hidden = false;
      document.body.style.overflow = "hidden";
      zoomClose?.focus();
    }

    function closeFullImage() {
      if (!zoomOverlay) return;
      zoomOverlay.hidden = true;
      document.body.style.overflow = "";
      zoomLastFocus?.focus?.();
    }

    function toggleActualSize() {
      if (!zoomTarget) return;
      const isActual = zoomTarget.classList.toggle("is-actual-size");
      if (zoomToggle) {
        zoomToggle.textContent = isActual ? "Fit to Screen" : "1:1 Actual Size";
      }
    }

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest("#img-zoom-close")) return closeFullImage();
      if (target.closest("#img-zoom-toggle") || target === zoomTarget) return toggleActualSize();
      if (!zoomOverlay.hidden && (target === zoomOverlay || target.id === "img-zoom-stage")) {
        return closeFullImage();
      }
      const fullImgTrigger = target.closest<HTMLElement>("[data-full-img]");
      if (fullImgTrigger) {
        const src = fullImgTrigger.getAttribute("data-full-img");
        const img = fullImgTrigger.querySelector("img");
        if (src) openFullImage(src, img?.alt || "Full-size image");
      }
    });

    document.addEventListener("keydown", (event) => {
      if (!zoomOverlay.hidden && event.key === "Escape") {
        closeFullImage();
        return;
      }
      const target = event.target as HTMLElement;
      const fullImgTrigger = target.closest<HTMLElement>("[data-full-img]");
      if ((event.key === "Enter" || event.key === " ") && fullImgTrigger) {
        event.preventDefault();
        const src = fullImgTrigger.getAttribute("data-full-img");
        const img = fullImgTrigger.querySelector("img");
        if (src) openFullImage(src, img?.alt || "Full-size image");
      }
    });
  }
  document.addEventListener("astro:page-load", wireStatuslineZoom);
  wireStatuslineZoom();
</script>
