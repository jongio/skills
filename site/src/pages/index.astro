---
import Layout from "../layouts/Layout.astro";
import SkillGrid from "../components/SkillGrid.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const skills = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout wide>
  <header class="hero">
    <p class="eyebrow">Skills for AI coding agents · Statuslines for Copilot CLI</p>
    <h1>jongio/skills</h1>
    <p class="lede">
      Give your agent a repeatable workflow for building, explaining, and maintaining projects.
      Add a live Copilot CLI footer to follow branches, worktrees, PRs, issues, and background agents.
    </p>
    <div class="cta">
      <a class="btn" href={`${base}catalog/`}>Browse skills</a>
      <a class="btn btn-ghost" href={`${base}statuslines/`}>CLI Statuslines</a>
      <a class="btn btn-ghost" href="https://github.com/jongio/skills">View on GitHub</a>
    </div>
    <div class="hero-cmds">
      <div class="hero-cmd-item">
        <span class="hero-cmd-label">1 · Add marketplace</span>
        <pre class="hero-cmd"><code>/plugin marketplace add jongio/skills</code></pre>
      </div>
      <div class="hero-cmd-item">
        <span class="hero-cmd-label">2 · Install all skills &amp; statuslines (or <code>&lt;skill&gt;@jongio-skills</code>)</span>
        <pre class="hero-cmd"><code>/plugin install jongio-skills@jongio-skills</code></pre>
      </div>
    </div>
  </header>

  <section>
    <div class="section-head">
      <h2 class="section-title">Skills</h2>
      <a class="section-link" href={`${base}catalog/`}>Browse all →</a>
    </div>
    <SkillGrid skills={skills} search={false} />
  </section>

  <section class="statusline-section">
    <div class="section-head">
      <h2 class="section-title">Copilot CLI Statuslines</h2>
      <a class="section-link" href={`${base}statuslines/`}>Open full documentation →</a>
    </div>
    <p class="muted" style="margin: 0 0 1rem;">
      Know where the agent is working and what needs attention without leaving the conversation. Enable the footer components you want with <code>/statusline-setup</code>.
    </p>

    <div class="statusline-showcase card">
      <div class="sl-shot-block">
        <div class="sl-shot-wrap" data-full-img={`${base}screenshots/statusline-worktree-grouped.svg`} role="button" tabindex="0" aria-label="View four-component grouped footer illustration full size">
          <img src={`${base}screenshots/statusline-worktree-grouped.svg`} alt="Matching headings above blue checkout pills, green passing PRs, an amber unassigned issue, and a purple merged subagent summary" loading="lazy" />
          <span class="sl-zoom-hint">Click to view full size</span>
        </div>
        <p class="sl-shot-sub">PRs appear beside their checkout. An unassigned issue and the overall subagent summary appear below. The path label is shown only for work outside Copilot's own checkout.</p>
      </div>

      <div class="sl-legend-grid">
        <div class="sl-legend-item"><strong class="sl-types-item c-worktree">Branch &amp; Worktree</strong><span>See the full path and live branch when work moves outside Copilot's checkout, plus changed files and missing commits.</span></div>
        <div class="sl-legend-item"><strong class="sl-types-item c-pr">Pull Requests</strong><span>Follow checks, approvals, and review threads. Open the PR on GitHub from its pill.</span></div>
        <div class="sl-legend-item"><strong class="sl-types-item c-issue">Issues</strong><span>Keep priority, assignees, linked PRs, and discussion counts beside the work.</span></div>
        <div class="sl-legend-item"><strong class="sl-types-item c-sub">Subagents</strong><span>See background work starting, exploring, in PR, merged, or failed. Inspect individual agents with <code>/tasks</code>.</span></div>
      </div>
      <p><a href={`${base}statuslines/`}>Read the symbols, colors, and setup guide →</a></p>
    </div>
  </section>

  <!-- Full-size image viewer overlay -->
  <div class="img-zoom-overlay" id="img-zoom-overlay" hidden role="dialog" aria-modal="true" aria-label="Full-size image viewer">
    <div class="img-zoom-toolbar">
      <button class="img-zoom-btn" id="img-zoom-toggle" type="button">1:1 Actual Size</button>
      <a class="img-zoom-btn" id="img-zoom-raw" href="#" target="_blank" rel="noopener">Open in new tab ↗</a>
      <button class="img-zoom-btn img-zoom-close" id="img-zoom-close" type="button" aria-label="Close full-size image">✕ Close</button>
    </div>
    <div class="img-zoom-stage" id="img-zoom-stage">
      <img id="img-zoom-target" alt="" />
    </div>
  </div>

  <section class="card install-card">
    <h2>Install</h2>
    <p class="muted">Add the marketplace once, then install a single skill or the entire collection.</p>
    <h3>1 · Add the Copilot plugin marketplace (one-time setup)</h3>
    <p class="muted">In Copilot CLI:</p>
    <pre><code>/plugin marketplace add jongio/skills</code></pre>
    <h3>2 · Install a single skill, statuslines only, or the full collection</h3>
    <p class="muted">Install just one skill from the marketplace:</p>
    <pre><code>/plugin install create-canvas-app@jongio-skills</code></pre>
    <p class="muted">Install just the Copilot CLI statuslines (without any skills):</p>
    <pre><code>/plugin install statuslines@jongio-skills</code></pre>
    <p class="muted">Or install all skills and statuslines together:</p>
    <pre><code>/plugin install jongio-skills@jongio-skills</code></pre>
    <p class="muted">Or in the Copilot app, no commands needed:</p>
    <ol class="steps">
      <li>
        <span>Open <strong>Settings</strong> and select <strong>Plugins</strong>.</span>
        <img class="shot" src={`${base}images/app-plugins-nav.png`} alt="Plugins in the settings sidebar" loading="lazy" />
      </li>
      <li>
        <span>Click <strong>Install ▾ → Add marketplace</strong>, enter <code>jongio/skills</code>, and click <strong>Add marketplace</strong>.</span>
        <img class="shot" src={`${base}images/app-add-marketplace.png`} alt="Add marketplace dialog with jongio/skills entered" loading="lazy" />
      </li>
      <li>
        <span>The marketplace's skills appear grouped under <strong>jongio-skills</strong>. Click <strong>Install</strong> on the one you want.</span>
        <img class="shot" src={`${base}images/app-browse-install.png`} alt="Browse the jongio-skills marketplace and install create-canvas-app" loading="lazy" />
      </li>
      <li>
        <span>The skill installs and is enabled, ready to use right away.</span>
        <img class="shot" src={`${base}images/app-installed.png`} alt="create-canvas-app installed and enabled" loading="lazy" />
      </li>
    </ol>
    <h3>Alternative: Skills CLI</h3>
    <pre><code>npx skills add jongio/skills --list</code></pre>
    <pre><code>npx skills add jongio/skills --skill create-canvas-app -g --agent github-copilot</code></pre>
    <h3>Other apps and editors</h3>
    <ul class="host-list">
      <li><strong>VS Code and Cursor:</strong> install <code>https://github.com/jongio/skills</code> as a plugin source.</li>
      <li><strong>Claude Code:</strong> add <code>jongio/skills</code> as a marketplace, then install <code>jongio-skills@jongio-skills</code>.</li>
      <li><strong>Codex CLI and ChatGPT desktop:</strong> add <code>jongio/skills</code> as a marketplace.</li>
      <li><strong>Gemini CLI:</strong> run <code>gemini extensions install https://github.com/jongio/skills</code>.</li>
      <li><strong>Other Agent Skills hosts:</strong> run <code>npx skills add jongio/skills</code>.</li>
    </ul>
    <p class="muted">
      ChatGPT web and mobile require public directory review. The Codex IDE
      extension accepts standalone skills but not plugins. See the <a href="https://github.com/jongio/skills#app-and-editor-support">complete support matrix</a>.
    </p>
    <p class="muted">In Copilot CLI, start a new session after installing statusline extensions. For skills alone, <code>/skills reload</code> refreshes the available skills.</p>
  </section>
</Layout>

<style>
  .hero { text-align: center; margin: 1rem 0 2.5rem; }
  .eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.74rem;
    font-weight: 600; color: var(--muted); margin: 0 0 0.5rem;
  }
  .hero h1 {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; margin: 0 0 0.75rem;
  }
  .lede { color: var(--muted); font-size: 1.12rem; max-width: 54ch; margin: 0 auto 1.4rem; }
  .cta { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.4rem; }
  .btn-ghost { background: var(--panel); color: var(--fg); border-color: var(--border); }
  .hero-cmds {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-width: 520px;
    margin: 0 auto;
    text-align: left;
  }
  .hero-cmd-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .hero-cmd-label {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    padding-left: 0.2rem;
  }
  .hero-cmd {
    margin: 0;
    width: 100%;
    overflow-x: auto;
    background: var(--panel);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    border-radius: 9px;
    padding: 0.7rem 1rem;
    font-weight: 600;
  }
  .section-title { font-size: 1.4rem; margin: 0 0 1rem; }
  .section-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; margin-bottom: 1rem;
  }
  .section-head .section-title { margin: 0; }
  .section-link { font-weight: 600; font-size: 0.92rem; white-space: nowrap; text-decoration: none; }
  .install-card { max-width: 860px; margin-left: auto; margin-right: auto; }
  .card pre {
    background: var(--bg); border: 1px solid var(--border); border-radius: 9px;
    padding: 0.7rem 0.9rem; overflow-x: auto;
  }
  .card h3 { font-size: 1rem; margin: 1.1rem 0 0.4rem; }
  .host-list { margin: 0.4rem 0 0; padding-left: 1.25rem; }
  .host-list li, .host-list code { overflow-wrap: anywhere; }
  .host-list li + li { margin-top: 0.35rem; }
  .steps { margin: 0.5rem 0 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 1.1rem; }
  .steps li { color: var(--fg); }
  .steps li > span { display: block; }
  .shot {
    display: block; margin: 0.55rem 0 0; max-width: 100%; height: auto;
    border: 1px solid var(--border); border-radius: 9px; background: var(--bg);
  }
  .statusline-section { margin: 2.5rem 0; }
  .statusline-showcase {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }
  .sl-install-primary {
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 12%, var(--bg)), var(--bg));
    border: 2px solid color-mix(in srgb, var(--accent) 60%, var(--border));
    border-radius: 12px;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-shadow: 0 10px 28px -14px rgba(0, 0, 0, 0.55);
  }
  .sl-primary-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sl-primary-title-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .sl-rec-badge {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--accent-solid);
    color: #fff;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
  }
  .sl-primary-title {
    color: var(--fg);
    font-size: clamp(1.15rem, 2.2vw, 1.38rem);
  }
  .sl-primary-sub {
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
  }
  .sl-primary-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .sl-scope-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.75rem;
  }
  .sl-scope-box {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 0.85rem;
  }
  .sl-scope-focus {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  }
  .sl-primary-pre {
    font-size: 0.96rem;
    font-weight: 600;
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border)) !important;
    padding: 0.8rem 3.8rem 0.8rem 1rem !important;
  }
  .sl-install-secondary {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .sl-secondary-summary {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .sl-secondary-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .sl-install-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sl-install-item pre { margin: 0; }
  .sl-os-label {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .sl-infographic-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .sl-shot-block {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: clamp(0.85rem, 2vw, 1.25rem);
  }
  .sl-types-item.c-worktree { color: var(--feature-worktree); }
  .sl-types-item.c-pr    { color: var(--feature-pr); }
  .sl-types-item.c-issue { color: var(--feature-issue); }
  .sl-types-item.c-sub   { color: var(--feature-subagent); }
  .sl-shot-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .sl-shot-header strong {
    color: var(--fg);
    font-size: 1.08rem;
    display: block;
    margin-bottom: 0.2rem;
  }
  .sl-shot-sub {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .sl-shot-wrap {
    position: relative;
    display: block;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0d1117;
    cursor: zoom-in;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .sl-shot-wrap:hover, .sl-shot-wrap:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 8px 28px -12px rgba(0, 0, 0, 0.65);
    outline: none;
  }
  .sl-shot-wrap img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 7px;
  }
  .sl-zoom-hint {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(13, 17, 23, 0.85);
    color: #e6edf3;
    border: 1px solid rgba(240, 246, 252, 0.22);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 0.76rem;
    font-weight: 600;
    pointer-events: none;
    opacity: 0.82;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }
  .sl-shot-wrap:hover .sl-zoom-hint {
    opacity: 1;
    border-color: var(--accent);
  }
  .sl-legend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 0.75rem;
    margin-top: 0.9rem;
  }
  .sl-legend-item {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.65rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.84rem;
    color: var(--muted);
  }
  .sl-legend-crop {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0d1117;
    cursor: zoom-in;
    transition: border-color 0.15s ease;
  }
  .sl-legend-crop:hover, .sl-legend-crop:focus-visible {
    border-color: var(--accent);
    outline: none;
  }
  .sl-legend-crop img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sl-legend-item code {
    align-self: flex-start;
    font-weight: 700;
    color: var(--fg);
  }
  .img-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(1, 4, 9, 0.92);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
  }
  .img-zoom-overlay[hidden] { display: none; }
  .img-zoom-toolbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: rgba(13, 17, 23, 0.9);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .img-zoom-btn {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: #e6edf3;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    text-decoration: none;
  }
  .img-zoom-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .img-zoom-stage {
    flex: 1;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  #img-zoom-target {
    display: block;
    max-width: 96vw;
    max-height: calc(94vh - 56px);
    width: auto;
    height: auto;
    border-radius: 8px;
    border: 1px solid #30363d;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.85);
    cursor: zoom-in;
  }
  #img-zoom-target.is-actual-size {
    max-width: none;
    max-height: none;
    width: auto;
    cursor: zoom-out;
    margin: auto;
  }
</style>

<script>
  function wireStatuslineZoom() {
    const zoomOverlay = document.getElementById("img-zoom-overlay");
    const zoomTarget = document.getElementById("img-zoom-target") as HTMLImageElement | null;
    const zoomToggle = document.getElementById("img-zoom-toggle");
    const zoomRaw = document.getElementById("img-zoom-raw") as HTMLAnchorElement | null;
    const zoomClose = document.getElementById("img-zoom-close") as HTMLElement | null;
    if (!zoomOverlay || !zoomTarget || zoomOverlay.dataset.wired) return;
    zoomOverlay.dataset.wired = "1";

    let zoomLastFocus: HTMLElement | null = null;

    function openFullImage(src: string, alt = "Full-size image") {
      if (!zoomOverlay || !zoomTarget) return;
      zoomLastFocus = document.activeElement as HTMLElement;
      zoomTarget.src = src;
      zoomTarget.alt = alt;
      zoomTarget.classList.remove("is-actual-size");
      if (zoomToggle) zoomToggle.textContent = "1:1 Actual Size";
      if (zoomRaw) zoomRaw.href = src;
      zoomOverlay.hidden = false;
      document.body.style.overflow = "hidden";
      zoomClose?.focus();
    }

    function closeFullImage() {
      if (!zoomOverlay) return;
      zoomOverlay.hidden = true;
      document.body.style.overflow = "";
      zoomLastFocus?.focus?.();
    }

    function toggleActualSize() {
      if (!zoomTarget) return;
      const isActual = zoomTarget.classList.toggle("is-actual-size");
      if (zoomToggle) {
        zoomToggle.textContent = isActual ? "Fit to Screen" : "1:1 Actual Size";
      }
    }

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest("#img-zoom-close")) return closeFullImage();
      if (target.closest("#img-zoom-toggle") || target === zoomTarget) return toggleActualSize();
      if (!zoomOverlay.hidden && (target === zoomOverlay || target.id === "img-zoom-stage")) {
        return closeFullImage();
      }
      const fullImgTrigger = target.closest<HTMLElement>("[data-full-img]");
      if (fullImgTrigger) {
        const src = fullImgTrigger.getAttribute("data-full-img");
        const img = fullImgTrigger.querySelector("img");
        if (src) openFullImage(src, img?.alt || "Full-size image");
      }
    });

    document.addEventListener("keydown", (event) => {
      if (!zoomOverlay.hidden && event.key === "Escape") {
        closeFullImage();
        return;
      }
      const target = event.target as HTMLElement;
      const fullImgTrigger = target.closest<HTMLElement>("[data-full-img]");
      if ((event.key === "Enter" || event.key === " ") && fullImgTrigger) {
        event.preventDefault();
        const src = fullImgTrigger.getAttribute("data-full-img");
        const img = fullImgTrigger.querySelector("img");
        if (src) openFullImage(src, img?.alt || "Full-size image");
      }
    });
  }
  document.addEventListener("astro:page-load", wireStatuslineZoom);
  wireStatuslineZoom();
</script>
