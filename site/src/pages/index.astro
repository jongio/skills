    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .sl-trio-item.c-pr    { color: #58a6ff; }
  .sl-trio-item.c-issue { color: #3fb950; }
  .sl-trio-item.c-sub   { color: #f2cc60; }
  .sl-trio-sep {
    color: var(--border);
    font-weight: 300;
  }
  .sl-shot-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .sl-shot-header strong {
    color: var(--fg);
    font-size: 1.08rem;
    display: block;
    margin-bottom: 0.2rem;
  }
  .sl-shot-sub {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .sl-shot-wrap {
    position: relative;
    display: block;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0d1117;
    cursor: zoom-in;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .sl-shot-wrap:hover, .sl-shot-wrap:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 8px 28px -12px rgba(0, 0, 0, 0.65);
    outline: none;
  }
  .sl-shot-wrap img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 7px;
  }
  .sl-zoom-hint {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(13, 17, 23, 0.85);
    color: #e6edf3;
    border: 1px solid rgba(240, 246, 252, 0.22);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 0.76rem;
    font-weight: 600;
    pointer-events: none;
    opacity: 0.82;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }
  .sl-shot-wrap:hover .sl-zoom-hint {
    opacity: 1;
    border-color: var(--accent);
  }
  .sl-legend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 0.75rem;
    margin-top: 0.9rem;
  }
  .sl-legend-item {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.65rem 0.75rem;
    display: flex;
