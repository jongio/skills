{
  "name": "git-tidy",
  "version": "1.0.0",
  "private": true,
  "description": "Dev tooling for the git-tidy skill (registration test + Vally eval). The shipped skill carries no package.json; this is for the skill repo only.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node test/registration.test.mjs",
    "eval:lint": "vally lint --eval-spec evals/git-tidy/eval.yaml --strict",
    "eval": "vally eval --eval-spec evals/git-tidy/eval.yaml --skill-dir ."
  },
  "devDependencies": {
    "@microsoft/vally-cli": "0.14.0"
  },
  "allowScripts": {
    "@vscode/deviceid": false,
    "better-sqlite3": false,
    "koffi": false
  }
}
