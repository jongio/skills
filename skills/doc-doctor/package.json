{
  "name": "doc-doctor",
  "version": "1.0.0",
  "private": true,
  "description": "Development tooling for the doc-doctor skill.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "eval:lint": "vally lint --eval-spec evals/doc-doctor/eval.yaml --strict",
    "eval": "vally eval --eval-spec evals/doc-doctor/eval.yaml --skill-dir ."
  },
  "devDependencies": {
    "@microsoft/vally-cli": "0.19.0"
  },
  "allowScripts": {
    "@vscode/deviceid": false,
    "better-sqlite3": false,
    "koffi": false
  }
}
