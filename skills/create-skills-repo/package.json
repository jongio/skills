{
  "name": "create-skills-repo",
  "version": "0.0.0",
  "private": true,
  "description": "Generator, validation, and deterministic tests for the create-skills-repo skill.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.11.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.mjs",
    "create": "node scripts/cli.mjs create",
    "upgrade": "node scripts/cli.mjs upgrade",
    "sync": "node scripts/cli.mjs sync",
    "check": "node scripts/cli.mjs check",
    "eval:lint": "vally lint --eval-spec evals/create-skills-repo/eval.yaml --strict",
    "eval": "vally eval --eval-spec evals/create-skills-repo/eval.yaml --skill-dir ."
  },
  "devDependencies": {
    "@microsoft/vally-cli": "0.14.0"
  },
  "allowScripts": {
    "@vscode/deviceid": false,
    "better-sqlite3": false,
    "koffi": false
  }
}
