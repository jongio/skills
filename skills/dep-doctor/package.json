{
  "name": "dep-doctor",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-package-manager dependency updates for any project: scan, update, fix breaking changes, and never roll back.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node test/registration.test.mjs",
    "eval:lint": "vally lint --eval-spec evals/dep-doctor/eval.yaml --strict",
    "eval": "vally eval --eval-spec evals/dep-doctor/eval.yaml --skill-dir ."
  },
  "devDependencies": {
    "@microsoft/vally-cli": "0.14.0"
  },
  "allowScripts": {
    "@vscode/deviceid": false,
    "better-sqlite3": false,
    "koffi": false
  }
}
